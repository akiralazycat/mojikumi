{
  "name": "mojikumi-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Japanese typography compatibility layer for the Web",
  "type": "module",
  "packageManager": "npm@10.9.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akiralazycat/mojikumi.git"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build:packages && npm run build:browser && npm run build --workspace @mojikumi/playground && npm run build --workspace @mojikumi/web",
    "build:web": "npm run build:packages && npm run build --workspace @mojikumi/web",
    "build:math": "npm run build --workspace @mojikumi/math-web",
    "build:chem": "npm run build --workspace @mojikumi/chem-web",
    "build:cdn": "npm run build:packages && npm run build:browser && node apps/cdn/build.mjs",
    "build:packages": "npm run clean && tsc -b packages/core packages/presets packages/dom packages/react packages/rehype packages/mojikumi && node scripts/build-css.mjs",
    "build:browser": "node scripts/build-browser.mjs",
    "dev": "npm run dev --workspace @mojikumi/web",
    "dev:math": "npm run dev --workspace @mojikumi/math-web",
    "dev:chem": "npm run dev --workspace @mojikumi/chem-web",
    "dev:playground": "npm run dev --workspace @mojikumi/playground",
    "test": "vitest run",
    "test:math:e2e": "npm run test:e2e --workspace @mojikumi/math-web",
    "test:chem:e2e": "npm run test:e2e --workspace @mojikumi/chem-web",
    "test:watch": "vitest",
    "typecheck": "tsc -b packages/core packages/presets packages/dom packages/react packages/rehype packages/mojikumi --pretty false",
    "clean": "node scripts/clean.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "package:check": "node scripts/check-packages.mjs",
    "release": "changeset publish",
    "measure:shift": "node scripts/measure-shift.mjs",
    "measure:cost": "node scripts/measure-cost.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@types/node": "^24.1.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "esbuild": "^0.28.1",
    "jsdom": "^26.1.0",
    "playwright-core": "^1.56.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "typescript": "^5.8.3",
    "vite": "^7.3.7",
    "vitest": "4.1.12"
  },
  "overrides": {
    "js-yaml@3": "3.15.2",
    "js-yaml@4": "4.3.2",
    "source-map-js@<1.2.2": "1.2.2",
    "compression": "1.8.2",
    "brace-expansion": "1.1.21",
    "fast-uri": "3.1.9"
  }
}
