{
  "name": "mojikumi",
  "version": "0.2.0",
  "description": "Japanese typography compatibility layer for the Web",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": "./dist/mojikumi.browser.js",
    "./css": "./dist/mojikumi.css",
    "./mojikumi.min.css": "./dist/mojikumi.min.css"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akiralazycat/mojikumi.git",
    "directory": "packages/mojikumi"
  },
  "homepage": "https://github.com/akiralazycat/mojikumi#readme",
  "bugs": "https://github.com/akiralazycat/mojikumi/issues",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@mojikumi/core": "0.2.0",
    "@mojikumi/css": "0.2.0",
    "@mojikumi/dom": "0.2.0",
    "@mojikumi/presets": "0.2.0"
  }
}
